# ============================================================
#  Simple Bank - .gitignore
# ============================================================

# --- Maven / build ---
target/
*.class
build/
out/
dist/

# --- Logi ---
*.log
logs/

# --- IntelliJ IDEA ---
# Pliki lokalne IDE, niepotrzebne w repozytorium
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/shelf/
.idea/dataSources/
.idea/dataSources.local.xml
.idea/httpRequests/
*.iml

# --- Eclipse ---
.classpath
.project
.settings/
bin/

# --- NetBeans ---
nbproject/private/
nbbuild/
nbdist/

# --- VS Code ---
.vscode/

# --- System operacyjny ---
.DS_Store
Thumbs.db
desktop.ini

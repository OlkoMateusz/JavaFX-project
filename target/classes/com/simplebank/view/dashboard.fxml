<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.simplebank.controller.DashboardController"
            prefWidth="900.0" prefHeight="640.0">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="header">
            <padding><Insets top="14.0" right="20.0" bottom="14.0" left="20.0"/></padding>
            <Label text="🏦 Simple Bank" styleClass="app-logo-small"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblWelcome" styleClass="welcome"/>
            <Button text="Wyloguj" onAction="#handleLogout" styleClass="btn-danger"/>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">

            <Tab text="Pulpit">
                <ScrollPane fitToWidth="true" styleClass="content-scroll">
                    <VBox spacing="16.0">
                        <padding><Insets top="18.0" right="20.0" bottom="18.0" left="20.0"/></padding>

                        <Label text="Twoje dane" styleClass="section-title"/>
                        <VBox spacing="6.0" styleClass="card-panel">
                            <HBox spacing="8.0">
                                <Label text="Imię i nazwisko:" styleClass="info-key"/>
                                <Label fx:id="lblImieNazwisko" styleClass="info-value"/>
                            </HBox>
                            <HBox spacing="8.0">
                                <Label text="E-mail:" styleClass="info-key"/>
                                <Label fx:id="lblEmail" styleClass="info-value"/>
                            </HBox>
                            <HBox spacing="8.0">
                                <Label text="PESEL:" styleClass="info-key"/>
                                <Label fx:id="lblPesel" styleClass="info-value"/>
                            </HBox>
                        </VBox>

                        <Label text="Twoje konta" styleClass="section-title"/>
                        <TableView fx:id="tableAccounts" prefHeight="140.0">
                            <columns>
                                <TableColumn fx:id="colNrKonta" text="Numer konta" prefWidth="280.0"/>
                                <TableColumn fx:id="colTypKonta" text="Rodzaj" prefWidth="160.0"/>
                                <TableColumn fx:id="colSaldo" text="Saldo" prefWidth="150.0"/>
                                <TableColumn fx:id="colStatus" text="Status" prefWidth="120.0"/>
                            </columns>
                        </TableView>

                        <HBox spacing="10.0">
                            <Button text="Przelew" onAction="#handleTransfer" styleClass="btn-primary"/>
                            <Button text="Wpłata" onAction="#handleDeposit" styleClass="btn-secondary"/>
                            <Button text="Wypłata" onAction="#handleWithdraw" styleClass="btn-secondary"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Odśwież" onAction="#handleRefresh" styleClass="btn-secondary"/>
                        </HBox>

                        <Label text="Historia transakcji" styleClass="section-title"/>
                        <TableView fx:id="tableTransactions" prefHeight="240.0">
                            <columns>
                                <TableColumn fx:id="colData" text="Data" prefWidth="150.0"/>
                                <TableColumn fx:id="colTyp" text="Typ" prefWidth="110.0"/>
                                <TableColumn fx:id="colKwota" text="Kwota" prefWidth="130.0"/>
                                <TableColumn fx:id="colFrom" text="Z konta" prefWidth="230.0"/>
                                <TableColumn fx:id="colTo" text="Na konto" prefWidth="230.0"/>
                            </columns>
                        </TableView>
                    </VBox>
                </ScrollPane>
            </Tab>

            <Tab text="Karty">
                <fx:include source="cards.fxml"/>
            </Tab>

            <Tab text="Kredyty">
                <fx:include source="loans.fxml"/>
            </Tab>

            <Tab text="Ustawienia">
                <fx:include source="settings.fxml"/>
            </Tab>

        </TabPane>
    </center>
</BorderPane>

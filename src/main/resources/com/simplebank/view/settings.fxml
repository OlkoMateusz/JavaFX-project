<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.simplebank.controller.SettingsController"
      spacing="18.0">
    <padding><Insets top="18.0" right="20.0" bottom="18.0" left="20.0"/></padding>

    <Label text="Zmiana adresu e-mail" styleClass="section-title"/>
    <VBox spacing="10.0" maxWidth="420.0" styleClass="card-panel">
        <padding><Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/></padding>
        <HBox spacing="8.0" alignment="CENTER_LEFT">
            <Label text="Obecny e-mail:" styleClass="info-key"/>
            <Label fx:id="lblCurrentEmail" styleClass="info-value"/>
        </HBox>
        <Label text="Nowy e-mail" styleClass="field-label"/>
        <TextField fx:id="newEmailField" promptText="nowy adres e-mail"/>
        <Button text="Zmień e-mail" onAction="#handleChangeEmail" styleClass="btn-primary"/>
    </VBox>

    <Label text="Zmiana hasła" styleClass="section-title"/>
    <VBox spacing="10.0" maxWidth="420.0" styleClass="card-panel">
        <padding><Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/></padding>
        <Label text="Dotychczasowe hasło" styleClass="field-label"/>
        <PasswordField fx:id="oldPasswordField" promptText="stare hasło"/>
        <Label text="Nowe hasło" styleClass="field-label"/>
        <PasswordField fx:id="newPasswordField" promptText="nowe hasło"/>
        <Label text="Powtórz nowe hasło" styleClass="field-label"/>
        <PasswordField fx:id="repeatPasswordField" promptText="powtórz nowe hasło"/>
        <Button text="Zmień hasło" onAction="#handleChangePassword" styleClass="btn-primary"/>
    </VBox>
</VBox>

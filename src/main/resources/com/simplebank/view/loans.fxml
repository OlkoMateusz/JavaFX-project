<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.simplebank.controller.LoansController"
      spacing="14.0">
    <padding><Insets top="18.0" right="20.0" bottom="18.0" left="20.0"/></padding>

    <Label text="Wniosek o kredyt" styleClass="section-title"/>

    <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="card-panel">
        <padding><Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/></padding>
        <Label text="Kwota (zł):" styleClass="field-label"/>
        <TextField fx:id="kwotaField" promptText="np. 10000" prefWidth="140.0"/>
        <Label text="Liczba miesięcy:" styleClass="field-label"/>
        <TextField fx:id="miesiaceField" promptText="np. 24" prefWidth="100.0"/>
        <Button text="Złóż wniosek" onAction="#handleApply" styleClass="btn-primary"/>
    </HBox>

    <Label text="Twoje kredyty" styleClass="section-title"/>
    <TableView fx:id="loansTable" prefHeight="340.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colKwota" text="Kwota" prefWidth="120.0"/>
            <TableColumn fx:id="colStopa" text="Oprocentowanie" prefWidth="120.0"/>
            <TableColumn fx:id="colMiesiace" text="Miesiące" prefWidth="90.0"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="110.0"/>
            <TableColumn fx:id="colSplacone" text="Spłacono" prefWidth="120.0"/>
            <TableColumn fx:id="colDoSplaty" text="Do spłaty (z odsetkami)" prefWidth="160.0"/>
            <TableColumn fx:id="colData" text="Data" prefWidth="150.0"/>
        </columns>
    </TableView>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.simplebank.controller.DepositController"
      spacing="12.0" prefWidth="380.0" styleClass="dialog-panel">
    <padding><Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/></padding>

    <Label text="Wpłata gotówki" styleClass="section-title"/>

    <Label text="Konto" styleClass="field-label"/>
    <ComboBox fx:id="accountCombo" maxWidth="Infinity"/>

    <Label text="Kwota (zł)" styleClass="field-label"/>
    <TextField fx:id="amountField" promptText="np. 100.00"/>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button text="Anuluj" onAction="#handleCancel" styleClass="btn-secondary"/>
        <Button text="Wpłać" onAction="#handleConfirm" styleClass="btn-primary"/>
    </HBox>
</VBox>
